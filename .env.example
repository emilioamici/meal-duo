# Opzionale: Client ID OAuth di Google precompilato (è un valore pubblico, non un segreto).
# In alternativa lo si inserisce dall'app: Famiglia → Sincronizzazione.
VITE_GOOGLE_CLIENT_ID=
# Opzionale: necessari solo per il Google Picker ("Scegli file da Drive")
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# Worker Cloudflare (accesso persistente + notifiche push): vedi worker/README.md. Valori pubblici.
VITE_PUSH_URL=
VITE_VAPID_PUBLIC_KEY=
